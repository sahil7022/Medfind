# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── PostgreSQL (Render managed database URL) ────────────────────────────────
# Leave empty to use the in-memory fallback store
DATABASE_URL=postgresql://user:password@hostname/dbname

# ─── Geoapify (geolocation, reverse geocoding, places search) ────────────────
# Free key: https://www.geoapify.com/
GEOAPIFY_API_KEY=YOUR_GEOAPIFY_KEY_HERE

# ─── Firebase (client-side, safe to expose — protected by Firebase rules) ────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# ─── Gemini AI (Symptom Checker & Medicine Assistant) ───────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

